Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host. cPanel also serves this addon domain's folder at
  # primarydomain.com/ahsuniqbal, where root-absolute /_next/ asset URLs cannot
  # resolve — send every non-canonical host (including www) to ahsuniqbal.com.
  # $1 is the path relative to this directory, so the /ahsuniqbal prefix drops.
  RewriteCond %{HTTP_HOST} !^ahsuniqbal\.com$ [NC]
  RewriteRule ^(.*)$ https://ahsuniqbal.com/$1 [L,R=301]

  # Force HTTPS (comment out these three lines if SSL is not installed yet)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://ahsuniqbal.com/$1 [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Hashed build assets never change: cache them for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always be revalidated so new deploys are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
